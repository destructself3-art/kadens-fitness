# Local SQLite database (path is relative to the project root)
DATABASE_URL="file:./prisma/dev.db"

# Admin panel password and the secret that signs the admin session cookie.
# Change both before deploying anywhere public.
ADMIN_PASSWORD="kadens"
ADMIN_SECRET="change-me-to-a-long-random-string"

# Portfolio demo: fills the schedule with believable bookings and the admin panel with leads,
# so nothing ever looks empty. Set to "false" for a real club.
DEMO_BOOKINGS="true"

# Public URL, used for social previews
SITE_URL="http://localhost:3200"
