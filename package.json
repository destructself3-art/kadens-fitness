{
  "name": "kadens-fitness",
  "version": "0.1.0",
  "private": true,
  "description": "Kadens: a large fitness club that trains to your heart rate. Portfolio site with a pulse-driven interface, program builder, live schedule with real booking and an admin panel.",
  "scripts": {
    "dev": "next dev --port 3200",
    "build": "next build",
    "start": "next start --port 3200",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "setup": "prisma migrate deploy && prisma db seed",
    "photos": "node scripts/process-photos.mjs",
    "shotlist": "node scripts/build-shotlist.mjs && node scripts/build-batch-prompts.mjs",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "clsx": "2.1.1",
    "framer-motion": "13.4.4",
    "lenis": "1.3.26",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "dotenv": "18.0.3",
    "postcss": "8.5.28",
    "prisma": "7.10.0",
    "sharp": "0.35.4",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
